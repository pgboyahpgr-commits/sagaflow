# ============================================================
# SagaFlow — Self-Hostable Workflow & Saga Orchestration Engine
# Zero-budget local defaults work out of the box with no setup!
# ============================================================

# Server & Split-Role Scaling
HOST=0.0.0.0
PORT=4000
NODE_ENV=development
# ROLE: all (default single-container), api (HTTP+UI only), worker (queue consumer + cron scheduler)
ROLE=all

# Auth mode:
#   dev  -> allows verified X-Tenant-Id / X-User-Id headers, JWT Bearer/cookie, AND X-Api-Key
#   prod -> requires cryptographic X-Api-Key or self-hosted JWT Bearer/cookie
AUTH_MODE=dev

# Demo data on first start (seeded tenants, workflows, demo admin).
# Automatically disabled when AUTH_MODE=prod unless set to true explicitly.
SEED_DEMO=true

# Encryption & Auth Secrets (optional — auto-generates 0600 <STORAGE_PATH>/.master.key locally)
# For multi-instance / hosted deployments set both to long random values so every
# replica shares the same vault key and JWT signing secret.
# SAGAFLOW_MASTER_KEY=replace-with-32-byte-random-secret
# SAGAFLOW_JWT_SECRET=replace-with-32-byte-jwt-secret

# Durable Cron Scheduler poll interval (milliseconds)
CRON_POLL_INTERVAL_MS=15000

# Pluggable Storage ("Store Anything Anywhere"):
#   sqlite   -> Zero-config embedded SQLite/libSQL (default)
#   json     -> Human-readable portable JSON files in any folder (Dropbox/Git/NFS/local)
#   postgres -> Production PostgreSQL with Row-Level Security (requires DATABASE_URL)
STORAGE_DRIVER=sqlite

# Multi-tenant isolation mode for sqlite driver:
#   db-per-tenant -> Each tenant gets its own isolated SQLite file (default, physical isolation!)
#   shared        -> Single database with strict tenant_id scoping
STORAGE_ISOLATION=db-per-tenant

# Local storage directory (for sqlite and json drivers)
STORAGE_PATH=./data

# Optional remote libSQL/Turso URL or PostgreSQL connection URL
# DATABASE_URL=postgres://sagaflow:sagaflow@localhost:5432/sagaflow
# LIBSQL_AUTH_TOKEN=

# Pluggable Queue:
#   local -> Durable in-process worker pool backed by StorageAdapter (default, $0)
#   nats  -> NATS JetStream distributed worker fleet (requires NATS_URL)
QUEUE_DRIVER=local
# NATS_URL=nats://localhost:4222
WORKER_CONCURRENCY=16

# Per-tenant API rate limit (requests per 60s window)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# QuickJS-WASM Script Sandbox limits
SANDBOX_MEMORY_LIMIT_MB=16
SANDBOX_TIMEOUT_MS=2000
